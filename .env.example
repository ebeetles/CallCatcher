# CallCatcher configuration — copy to .env at the repo root.
# Every key is optional: anything missing falls back to a mock provider,
# so the dashboard, chat simulator, and fake calls work with NO keys at all.

# ---------- server ----------
# API server port (the web dev server proxies /api and /media-stream here).
PORT=8787
HOST=0.0.0.0

# Public https base URL Twilio uses to reach this server (webhooks + media stream).
# Required for real phone calls. For local dev use a tunnel, e.g.:
#   ngrok http 8787   →   PUBLIC_URL=https://<something>.ngrok.app
PUBLIC_URL=

# SQLite location (default: server/data/callcatcher.sqlite)
#DB_PATH=

# ---------- auth (SaaS multi-tenant) ----------
# Supabase project for account signup/login (Auth only — data stays in SQLite).
# Setting SUPABASE_URL switches the API to supabase auth mode: every /api
# request needs a Supabase access JWT. Find these in Supabase → Project Settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Legacy HS256 JWT secret — only needed for older Supabase projects that don't
# publish asymmetric keys (Settings → API → JWT Secret). Newer projects verify
# via the JWKS endpoint automatically; leave empty then.
SUPABASE_JWT_SECRET=

# Comma-separated emails that become platform admins on signup (see all legacy
# data, /admin APIs). Your own email goes here before you first sign up.
ADMIN_EMAILS=

# ---------- security ----------
# Ops bearer token (break-glass/CLI/platform-admin; also the only login in
# legacy token mode when Supabase is not configured). Generate one:
#   openssl rand -hex 24
DASHBOARD_TOKEN=

# Extra browser origins allowed to call the API, comma-separated. localhost and
# PUBLIC_URL are always allowed; set this only if the dashboard is hosted
# somewhere else (e.g. Vercel).
#ALLOWED_ORIGINS=https://dashboard.example.com

# Force mock providers even when keys are set (demos, tests).
#MOCK_PROVIDERS=1

# ---------- AI providers ----------
# Claude — used for (a) live call reasoning and (b) the factory that refines
# prompts and extracts business info from websites.
ANTHROPIC_API_KEY=

# Optional alternate call-time LLM.
OPENAI_API_KEY=

# Deepgram — streaming speech-to-text AND default text-to-speech (Aura).
DEEPGRAM_API_KEY=

# Optional premium TTS.
ELEVENLABS_API_KEY=

# ---------- telephony ----------
# Twilio — buy/attach numbers and receive calls. Without these you can still
# run web test calls; you just can't put a receptionist on a real number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------- model choices ----------
# Model used during live calls (latency-critical; small + fast wins).
#CALL_MODEL_ANTHROPIC=claude-haiku-4-5
#CALL_MODEL_OPENAI=gpt-4o-mini
# Model used by the factory for prompt-writing / website extraction (one-shot, quality-critical).
#FACTORY_MODEL=claude-opus-4-8
